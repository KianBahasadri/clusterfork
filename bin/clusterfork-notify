#!/usr/bin/env bash
# Shared turn-completion notifier: ring locally and optionally publish to ntfy.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clusterfork_dir="${CLUSTERFORK_DIR:-$(cd "$script_dir/.." && pwd)}"

# shellcheck source=notify
. "$script_dir/notify"
notify_load_env "$clusterfork_dir"
notify_load_prefs "$clusterfork_dir"

agent="${1:-agent}"
if [[ -n "${NOTIFY_PREF[$agent]+x}" && "${NOTIFY_PREF[$agent]}" != 1 ]]; then
  exit 0
fi

case "$agent" in
  claude) label="Claude" ;;
  codex) label="Codex" ;;
  command-code) label="Command Code" ;;
  grok) label="Grok" ;;
  antigravity) label="Antigravity" ;;
  *) label="Agent" ;;
esac

# Antigravity Stop fires on tool yields and subagent cycles. Gate on
# fullyIdle, and take the project name from workspacePaths because the hook
# cwd is the hooks.json directory. Stdin is inspected locally, never forwarded.
antigravity_gate() {
  python3 -c '
import json, os, sys
raw = sys.stdin.read().strip()
if not raw.startswith("{"):
    sys.exit(1)
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    sys.exit(1)
if data.get("fullyIdle") is not True:
    sys.exit(1)
paths = data.get("workspacePaths") or []
path = paths[0] if isinstance(paths, list) and paths else ""
name = os.path.basename(str(path).rstrip("/")) or "workspace"
if name in ("", "/"):
    name = "workspace"
print(name)
'
}

if [[ "$agent" == antigravity ]]; then
  project="$(antigravity_gate 2>/dev/null)" || exit 0
else
  project="$(basename "${PWD:-workspace}")"
fi
[[ -n "$project" && "$project" != "/" ]] || project="workspace"

# The network timeout stays below bell.mp3's duration, so phone delivery adds
# no latency to the existing synchronous hooks. Neither path can fail a turn.
pids=()
if [[ "${NOTIFY_PREF[bell]}" == 1 ]]; then
  notify_play_bell "$clusterfork_dir" &
  pids+=("$!")
fi
if [[ "${NOTIFY_PREF[phone]}" == 1 ]]; then
  notify_post_ntfy "$label finished" "Turn complete in $project" &
  pids+=("$!")
fi
if (( ${#pids[@]} )); then
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
fi
exit 0
