#!/usr/bin/env bash
# Shared turn-completion notifier: ring locally and optionally publish to ntfy.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clusterfork_dir="${CLUSTERFORK_DIR:-$(cd "$script_dir/.." && pwd)}"

# shellcheck source=notify
. "$script_dir/notify"
notify_load_env "$clusterfork_dir"
notify_load_prefs "$clusterfork_dir"

relayed=0
if [[ "${1:-}" == --from-devbox ]]; then
  relayed=1
  shift
fi
agent="${1:-agent}"
if (( relayed )); then
  # The host relay has already validated metadata and the guest has applied
  # the Stop-event gates. Keep host switches as an additional veto.
  case "$agent" in
    claude|codex|command-code|grok|antigravity|agent|test) ;;
    *) exit 0 ;;
  esac
  case "${3:-}" in
    bell) NOTIFY_PREF[phone]=0 ;;
    phone) NOTIFY_PREF[bell]=0 ;;
    bell,phone) ;;
    *) exit 0 ;;
  esac
fi
if [[ -n "${NOTIFY_PREF[$agent]+x}" && "${NOTIFY_PREF[$agent]}" != 1 ]]; then
  exit 0
fi

case "$agent" in
  claude) label="Claude" ;;
  codex) label="Codex" ;;
  command-code) label="Command Code" ;;
  grok) label="Grok" ;;
  antigravity) label="Antigravity" ;;
  test) label="Clusterfork test" ;;
  *) label="Agent" ;;
esac

# Antigravity Stop fires on tool yields and subagent cycles. Gate on
# fullyIdle, and take the project name from workspacePaths because the hook
# cwd is the hooks.json directory. Stdin is inspected locally, never forwarded.
antigravity_gate() {
  python3 -c '
import json, os, sys
raw = sys.stdin.read().strip()
if not raw.startswith("{"):
    sys.exit(1)
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    sys.exit(1)
if data.get("fullyIdle") is not True:
    sys.exit(1)
paths = data.get("workspacePaths") or []
path = paths[0] if isinstance(paths, list) and paths else ""
name = os.path.basename(str(path).rstrip("/")) or "workspace"
if name in ("", "/"):
    name = "workspace"
print(name)
'
}

# Grok Stop fires on turn completions (reason: "end_turn") and on session
# teardown/exit (reason: "channel_closed" or "shutdown"). Gate on
# reason == "end_turn" so exiting Grok does not fire the completion notifier.
# Stdin is inspected locally, never forwarded.
grok_gate() {
  python3 -c '
import json, sys
raw = sys.stdin.read().strip()
if not raw.startswith("{"):
    sys.exit(0)
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    sys.exit(0)
reason = data.get("reason")
if reason is not None and reason != "end_turn":
    sys.exit(1)
'
}

if (( relayed )); then
  project="${2:-workspace}"
elif [[ "$agent" == antigravity ]]; then
  project="$(antigravity_gate 2>/dev/null)" || exit 0
elif [[ "$agent" == grok ]]; then
  grok_gate 2>/dev/null || exit 0
  project="$(basename "${PWD:-workspace}")"
else
  project="$(basename "${PWD:-workspace}")"
fi
[[ -n "$project" && "$project" != "/" ]] || project="workspace"

if (( ! relayed )) && [[ -n "${CLUSTERFORK_NOTIFY_RELAY_SOCKET:-}" ]]; then
  channels=()
  [[ "${NOTIFY_PREF[bell]}" == 1 ]] && channels+=(bell)
  [[ "${NOTIFY_PREF[phone]}" == 1 ]] && channels+=(phone)
  if (( ${#channels[@]} )); then
    notifications="$(IFS=,; printf '%s' "${channels[*]}")"
    if notify_relay "$agent" "$project" "$notifications" >/dev/null 2>&1; then
      notify_record_trigger "$clusterfork_dir" "$agent" "$notifications"
    fi
  fi
  exit 0
fi

# The network timeout stays below bell.mp3's duration, so phone delivery adds
# no latency to the existing synchronous hooks. Neither path can fail a turn.
pids=()
channels=()
triggered_at="$(notify_history_timestamp 2>/dev/null || true)"
if [[ "${NOTIFY_PREF[bell]}" == 1 ]]; then
  notify_play_bell "$clusterfork_dir" &
  pids+=("$!")
  channels+=(bell)
  if (( relayed )) && command -v notify-send >/dev/null 2>&1; then
    # Fixed title/body only: no guest-selected actions, files, commands or URLs.
    timeout 3 notify-send --app-name=Clusterfork --urgency=critical \
      "Devbox: $label finished" "Turn complete in $project" \
      </dev/null >/dev/null 2>&1 &
    pids+=("$!")
  fi
fi
if [[ "${NOTIFY_PREF[phone]}" == 1 ]]; then
  notify_post_ntfy "$label finished" "Turn complete in $project" &
  pids+=("$!")
  channels+=(phone)
fi
if (( ${#pids[@]} )); then
  notifications="$(IFS=,; printf '%s' "${channels[*]}")"
  notify_record_trigger "$clusterfork_dir" "$agent" "$notifications" "$triggered_at"
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
fi
exit 0
