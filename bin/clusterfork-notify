#!/usr/bin/env bash
# Shared turn-completion notifier: ring locally and optionally publish to ntfy.

set -u

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
clusterfork_dir="${CLUSTERFORK_DIR:-$(cd "$script_dir/.." && pwd)}"

# shellcheck source=notify
. "$script_dir/notify"
notify_load_env "$clusterfork_dir"
notify_load_prefs "$clusterfork_dir"

agent="${1:-agent}"
if [[ -n "${NOTIFY_PREF[$agent]+x}" && "${NOTIFY_PREF[$agent]}" != 1 ]]; then
  exit 0
fi

case "$agent" in
  claude) label="Claude" ;;
  codex) label="Codex" ;;
  command-code) label="Command Code" ;;
  grok) label="Grok" ;;
  antigravity) label="Antigravity" ;;
  *) label="Agent" ;;
esac

# Antigravity Stop fires on tool yields and subagent cycles. Gate on
# fullyIdle, and take the project name from workspacePaths because the hook
# cwd is the hooks.json directory. Stdin is inspected locally, never forwarded.
antigravity_gate() {
  python3 -c '
import json, os, sys
raw = sys.stdin.read().strip()
if not raw.startswith("{"):
    sys.exit(1)
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    sys.exit(1)
if data.get("fullyIdle") is not True:
    sys.exit(1)
paths = data.get("workspacePaths") or []
path = paths[0] if isinstance(paths, list) and paths else ""
name = os.path.basename(str(path).rstrip("/")) or "workspace"
if name in ("", "/"):
    name = "workspace"
print(name)
'
}

if [[ "$agent" == antigravity ]]; then
  project="$(antigravity_gate 2>/dev/null)" || exit 0
else
  project="$(basename "${PWD:-workspace}")"
fi
[[ -n "$project" && "$project" != "/" ]] || project="workspace"
sound="${CLUSTERFORK_NOTIFY_SOUND:-$clusterfork_dir/bell.mp3}"

ring_local() {
  if command -v mpv >/dev/null 2>&1 && [[ -f "$sound" ]]; then
    mpv --no-video --no-terminal "$sound" </dev/null >/dev/null 2>&1 || true
  elif [[ -w /dev/tty ]]; then
    printf '\a' >/dev/tty 2>/dev/null || true
  fi
}

notify_phone() {
  local url="${CLUSTERFORK_NTFY_URL:-}"
  [[ -n "$url" ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0

  local -a args=(
    --fail
    --silent
    --show-error
    --connect-timeout 1
    --max-time 3
    --request POST
    --header "X-Title: $label finished"
    --header "X-Priority: high"
    --header "X-Tags: robot"
    --data-binary "Turn complete in $project"
  )
  if [[ -n "${CLUSTERFORK_NTFY_TOKEN:-}" ]]; then
    args+=(--header "Authorization: Bearer $CLUSTERFORK_NTFY_TOKEN")
  fi

  curl "${args[@]}" "$url" </dev/null >/dev/null 2>&1 || true
}

# The network timeout stays below bell.mp3's duration, so phone delivery adds
# no latency to the existing synchronous hooks. Neither path can fail a turn.
pids=()
if [[ "${NOTIFY_PREF[bell]}" == 1 ]]; then
  ring_local &
  pids+=("$!")
fi
if [[ "${NOTIFY_PREF[phone]}" == 1 ]]; then
  notify_phone &
  pids+=("$!")
fi
if (( ${#pids[@]} )); then
  for pid in "${pids[@]}"; do
    wait "$pid" 2>/dev/null || true
  done
fi
exit 0
