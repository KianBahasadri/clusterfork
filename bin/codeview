#!/usr/bin/env python3
"""codeview — repo introspection dashboard launcher.

Resolves the current git repository, applies the house tmux-wrapping rules
(fresh session named after basename(PWD), collision suffixes, CF_NO_TMUX /
in-tmux / non-TTY bypasses), and serves the dashboard UI at a stable
per-repo localhost port. Data caches under <repo>/.codeview/; drop-in
modules live in <repo>/.codeview/modules/*.py. See docs/dashboard.md.

Usage: codeview [--port N] [--max-commits N] [--reindex] [--no-watch] [-h]
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time
import webbrowser
from pathlib import Path


def fail(msg: str, hint: str | None = None) -> None:
    print(f"  ✗  {msg}", file=sys.stderr)
    if hint:
        print(f"       {hint}", file=sys.stderr)
    raise SystemExit(1)


def parse_args(argv=None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="codeview",
        description="Repo introspection dashboard for the current git repo.")
    parser.add_argument("--port", type=int,
                        help="port to serve on (default: stable per-repo "
                             "hash in the 46000s)")
    parser.add_argument("--max-commits", type=int, default=1000,
                        help="history scan depth (default 1000)")
    parser.add_argument("--reindex", action="store_true",
                        help="force full rescan on boot, ignoring cache")
    parser.add_argument("--no-watch", action="store_true",
                        help="disable background rescan/restart watcher")
    return parser.parse_args(argv)


def clusterfork_dir() -> Path:
    override = os.environ.get("CLUSTERFORK_DIR")
    base = Path(override) if override else Path.home() / ".config/clusterfork"
    server_py = base / "scripts" / "codeview" / "server.py"
    if not server_py.is_file():
        fail(f"codeview server not found at {server_py}",
             "Re-run install-clusterfork.sh.")
    return base


# ------------------------------------------------------------- tmux rules --

def sanitize_session_name(raw: str) -> str:
    """Mirror shell/_tmux.sh exactly so both produce identical names."""
    base = raw if raw and raw != "/" else "root"
    name = base.replace(".", "-").replace(":", "-")
    if name.startswith("-"):
        name = f"_{name}"
    return name or "default"


def should_wrap_in_tmux(env: dict[str, str]) -> bool:
    """House bypasses: CF_NO_TMUX, already inside tmux, non-TTY stdin."""
    if env.get("CF_NO_TMUX") or env.get("TMUX"):
        return False
    try:
        return sys.stdin.isatty()
    except (OSError, ValueError):
        return False


def pick_session_name(candidate: str, *, runner=lambda args: 0) -> str:
    """First non-colliding name following the house -1/-2 suffix rule."""
    base = sanitize_session_name(candidate)
    name = base
    i = 1
    while runner(["tmux", "has-session", "-t", name]) == 0:
        name = f"{base}-{i}"
        i += 1
    return name


def tmux_available() -> bool:
    return shutil.which("tmux") is not None


# ------------------------------------------------------------- port/open --

def port_alive(port: int, timeout: float = 0.4) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def open_when_ready(port: int, url: str) -> None:
    """Poll until the server answers, then open the browser. Runs in a
    daemon thread so it cannot block or crash the launch."""
    for _ in range(60):
        if port_alive(port):
            print(f"codeview running at {url}")
            try:
                webbrowser.open(url)
            except Exception:  # noqa: BLE001 — opening is best-effort
                pass
            return
        time.sleep(0.5)
    print("codeview: server did not answer within 30s", file=sys.stderr)


# ------------------------------------------------------------------ main --

def main(argv=None) -> int:
    args = parse_args(argv)
    if shutil.which("git") is None:
        fail("git is required", "codeview introspects git repositories.")
    cf_dir = clusterfork_dir()
    scripts_dir = cf_dir / "scripts"
    server_py = scripts_dir / "codeview" / "server.py"

    # Import the server package directly: no duplicated port/root helpers.
    sys.path.insert(0, str(scripts_dir))
    try:
        from codeview import scan  # noqa: E402
        from codeview.server import default_port  # noqa: E402
    except ImportError as exc:
        fail(f"cannot load codeview modules from {scripts_dir}: {exc}",
             "Re-run install-clusterfork.sh.")

    root = scan.repo_root(Path.cwd())
    if root is None:
        fail("not inside a git repository", "cd into a repo and retry.")

    port = args.port or default_port(root)

    # Already serving this repo? Just open it again instead of failing bind.
    if port_alive(port):
        url = f"http://127.0.0.1:{port}/"
        print(f"codeview already running at {url}")
        try:
            webbrowser.open(url)
        except Exception:  # noqa: BLE001
            pass
        return 0

    url = f"http://127.0.0.1:{port}/"
    server_args = [
        "--repo", str(root),
        "--port", str(port),
        "--max-commits", str(args.max_commits),
    ]
    if args.reindex:
        server_args.append("--reindex")
    if args.no_watch:
        server_args.append("--no-watch")

    wrap = should_wrap_in_tmux(os.environ) and tmux_available()
    if wrap:
        name = pick_session_name(
            os.path.basename(str(root)),
            runner=lambda cmd: subprocess.run(
                cmd, capture_output=True).returncode,
        )
        threading.Thread(target=open_when_ready, args=(port, url),
                         daemon=True).start()
        result = subprocess.run(
            ["tmux", "new-session", "-s", name, "-c", str(root), "--",
             sys.executable, str(server_py), *server_args])
        return result.returncode

    # Bypass mode (headless/CI/in-tmux): serve in-process so Ctrl-C stops it.
    from codeview.server import main as server_main  # noqa: E402
    return server_main(server_args)


if __name__ == "__main__":
    sys.exit(main())
