#!/usr/bin/env python3
"""Read an agent's launch-time account label without changing credentials."""

import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from rotate_auth import (  # noqa: E402
    ClaudeBackend,
    PROFILE_PREFIX,
    SharedStoreBackend,
    SUFFIX_RE,
    env_path,
    make_backend,
)


def read_json(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def account_name(agent):
    if agent == "cmd":
        return read_json(Path.home() / ".commandcode/auth.json").get("userName")

    backend = make_backend("opencode" if agent == "occ" else agent)
    if isinstance(backend, ClaudeBackend):
        backend.claude_dir = env_path("CLAUDE_CONFIG_DIR", backend.claude_dir)
        backend.active = backend.claude_dir / ".credentials.json"
        name = backend.current_suffix()
        if name:
            return name
        # Claude records the selected account separately from its tokens.
        state = (backend.claude_dir / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR")
                 else Path.home() / ".claude.json")
        account = read_json(state).get("oauthAccount")
        if isinstance(account, dict):
            return account.get("emailAddress")
        return None
    if isinstance(backend, SharedStoreBackend):
        auth = backend.auth
        if agent == "codex":
            auth = env_path("CODEX_HOME", backend.agent_dir) / "auth.json"
        if agent == "occ":
            auth = env_path("OCC_OPENCODE_AUTH_FILE", auth)
            key = os.environ.get("OPENCODE_API_KEY")
            if key:
                for name in backend.suffixes():
                    saved = read_json(backend.store_dir / f"{PROFILE_PREFIX}{name}")
                    go = saved.get("opencode-go")
                    if isinstance(go, dict) and go.get("key") == key:
                        return name
                return None
        # Follow the credentials the agent will read. The store's current link
        # may still name an old account after --unhook or a fresh login.
        if auth.is_symlink():
            target = auth.resolve(strict=True)
            if target.is_file() and target.name.startswith(PROFILE_PREFIX):
                name = target.name[len(PROFILE_PREFIX):]
                return name if SUFFIX_RE.fullmatch(name) else None
        if agent == "grok":
            emails = {
                entry["email"] for entry in read_json(auth).values()
                if isinstance(entry, dict) and isinstance(entry.get("email"), str)
                and entry["email"]
            }
            return next(iter(emails)) if len(emails) == 1 else None
        return None
    return backend.current_suffix()


def main():
    agent = sys.argv[1]
    try:
        name = account_name(agent)
    except (OSError, UnicodeError, ValueError, RuntimeError):
        name = None
    # Usernames can contain spaces; discard controls and tmux format markers.
    if isinstance(name, str):
        name = "".join(c for c in name if c.isprintable() and c != "#").strip()
    else:
        name = ""
    print(f"{agent} - {name or 'unknown'}")


if __name__ == "__main__":
    main()
