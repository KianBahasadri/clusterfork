#!/usr/bin/env python3
"""Read an agent's launch-time account label without changing credentials."""

import json
import os
from pathlib import Path
import re
import sys

SUFFIX_RE = re.compile(r"^[A-Za-z0-9._-]+$")
PROFILE_PREFIX = "auth.json."
CLAUDE_PREFIX = ".credentials.json."

SHARED_STORES = {
    "codex": ("ROTATE_CODEX_CODEX_DIR", "ROTATE_CODEX_AUTH_STORE_DIR", ".codex", ".local/share/clusterfork-auth/codex"),
    "cursor": ("ROTATE_CURSOR_DIR", "ROTATE_CURSOR_AUTH_STORE_DIR", ".config/cursor", ".local/share/clusterfork-auth/cursor"),
    "grok": ("ROTATE_GROK_DIR", "ROTATE_GROK_AUTH_STORE_DIR", ".grok", ".local/share/clusterfork-auth/grok"),
    "opencode": ("ROTATE_OPENCODE_DIR", "ROTATE_OPENCODE_AUTH_STORE_DIR", ".local/share/opencode", ".local/share/clusterfork-auth/opencode"),
}


def env_path(name, default):
    value = os.environ.get(name)
    return Path(value) if value else default


def read_json(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _claude_token(path):
    oauth = read_json(path).get("claudeAiOauth")
    if isinstance(oauth, dict):
        token = oauth.get("accessToken")
        if isinstance(token, str) and token:
            return token
    return None


def _prefixed_names(directory, prefix):
    if not directory.is_dir():
        return []
    names = []
    try:
        with os.scandir(directory) as it:
            for entry in it:
                if entry.name.startswith(prefix) and len(entry.name) > len(prefix):
                    try:
                        if entry.is_file(follow_symlinks=True) or entry.is_symlink():
                            names.append(entry.name[len(prefix):])
                    except OSError:
                        continue
    except OSError:
        return []
    return sorted(names)


def account_name(agent):
    home = Path.home()
    if agent == "cmd":
        return read_json(home / ".commandcode/auth.json").get("userName")

    if agent == "claude":
        claude_dir = env_path("CLAUDE_CONFIG_DIR", env_path("ROTATE_CLAUDE_DIR", home / ".claude"))
        token = _claude_token(claude_dir / ".credentials.json")
        if token:
            for name in _prefixed_names(claude_dir, CLAUDE_PREFIX):
                path = claude_dir / f"{CLAUDE_PREFIX}{name}"
                if path.is_file() and _claude_token(path) == token:
                    return name
        # Claude records the selected account separately from its tokens.
        state = (claude_dir / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR")
                 else home / ".claude.json")
        account = read_json(state).get("oauthAccount")
        if isinstance(account, dict):
            return account.get("emailAddress")
        return None

    if agent == "antigravity":
        state_dir = env_path("ROTATE_ANTIGRAVITY_STATE_DIR", home / ".gemini/antigravity-cli/rotate-auth")
        current_file = state_dir / "current"
        if current_file.is_file():
            raw = current_file.read_text(encoding="utf-8").splitlines()
            name = raw[0] if raw else ""
            return name if SUFFIX_RE.fullmatch(name) else None
        return None

    store_key = "opencode" if agent == "occ" else agent
    if store_key in SHARED_STORES:
        agent_env, store_env, default_agent, default_store = SHARED_STORES[store_key]
        agent_dir = env_path(agent_env, home / default_agent)
        store_dir = env_path(store_env, home / default_store)
        auth = env_path("CODEX_HOME", agent_dir) / "auth.json" if agent == "codex" else agent_dir / "auth.json"
        if agent == "occ":
            auth = env_path("OCC_OPENCODE_AUTH_FILE", auth)
            key = os.environ.get("OPENCODE_API_KEY")
            if key:
                for name in _prefixed_names(store_dir, PROFILE_PREFIX):
                    saved = read_json(store_dir / f"{PROFILE_PREFIX}{name}")
                    go = saved.get("opencode-go")
                    if isinstance(go, dict) and go.get("key") == key:
                        return name
                return None
        # Follow the credentials the agent will read. The store's current link
        # may still name an old account after --unhook or a fresh login.
        if auth.is_symlink():
            target = auth.resolve(strict=True)
            if target.is_file() and target.name.startswith(PROFILE_PREFIX):
                name = target.name[len(PROFILE_PREFIX):]
                return name if SUFFIX_RE.fullmatch(name) else None
        if agent == "grok":
            emails = {
                entry["email"] for entry in read_json(auth).values()
                if isinstance(entry, dict) and isinstance(entry.get("email"), str)
                and entry["email"]
            }
            return next(iter(emails)) if len(emails) == 1 else None
        return None

    return None


def format_label(agent):
    try:
        name = account_name(agent)
    except (OSError, UnicodeError, ValueError, RuntimeError):
        name = None
    # Usernames can contain spaces; discard controls and tmux format markers.
    if isinstance(name, str):
        name = "".join(c for c in name if c.isprintable() and c != "#").strip()
    else:
        name = ""
    return f"{agent} - {name or 'unknown'}"


def main():
    print(format_label(sys.argv[1]))


if __name__ == "__main__":
    main()
