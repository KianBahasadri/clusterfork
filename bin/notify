#!/usr/bin/env bash
# Toggle and show turn-completion notification prefs.
# Sourced by clusterfork-notify for the same prefs file.

NOTIFY_TARGETS=(bell phone claude codex command-code grok antigravity)
NOTIFY_AGENTS=(claude codex command-code grok antigravity)
declare -A NOTIFY_PREF=()
NOTIFY_VOLUME=100

notify_clusterfork_dir() {
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  printf '%s' "${CLUSTERFORK_DIR:-$(cd "$here/.." && pwd)}"
}

notify_load_env() {
  local dir="$1"
  local env_file="${CLUSTERFORK_ENV_FILE:-$dir/.env}"
  local config_file
  for config_file in "$dir/notify/settings.env" "$env_file"; do
    if [[ -f "$config_file" ]]; then
      set -a
      # shellcheck source=/dev/null
      . "$config_file" 2>/dev/null || true
      set +a
    fi
  done
}

notify_parse_bool() {
  case "$1" in
    1|on|true|yes) printf 1 ;;
    0|off|false|no) printf 0 ;;
    *) return 1 ;;
  esac
}

notify_is_target() {
  local target="$1" item
  for item in "${NOTIFY_TARGETS[@]}"; do
    [[ "$item" == "$target" ]] && return 0
  done
  return 1
}

notify_parse_volume() {
  local raw="${1%"%"}"
  [[ "$raw" =~ ^[0-9]+$ ]] || return 1
  raw="$((10#$raw))"
  if (( raw > 100 )); then
    return 1
  fi
  printf '%s' "$raw"
}

notify_defaults() {
  local key
  NOTIFY_PREF=()
  for key in "${NOTIFY_TARGETS[@]}"; do
    NOTIFY_PREF["$key"]=1
  done
  NOTIFY_VOLUME=100
}

notify_load_prefs() {
  local prefs="$1/notify-prefs" line key value parsed
  notify_defaults
  [[ -f "$prefs" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    if [[ "$key" == volume ]]; then
      parsed="$(notify_parse_volume "$value")" || continue
      NOTIFY_VOLUME="$parsed"
      continue
    fi
    notify_is_target "$key" || continue
    parsed="$(notify_parse_bool "$value")" || continue
    NOTIFY_PREF["$key"]="$parsed"
  done < "$prefs"
}

notify_save_prefs() {
  local prefs="$1/notify-prefs" tmp key
  tmp="$prefs.tmp.$$"
  {
    for key in "${NOTIFY_TARGETS[@]}"; do
      printf '%s=%s\n' "$key" "${NOTIFY_PREF[$key]}"
    done
    printf 'volume=%s\n' "$NOTIFY_VOLUME"
  } > "$tmp"
  mv -f "$tmp" "$prefs"
}

notify_state_word() {
  if [[ "${NOTIFY_PREF[$1]}" == 1 ]]; then
    printf on
  else
    printf off
  fi
}

notify_effective() {
  local key
  if [[ "${NOTIFY_PREF[bell]}" != 1 && "${NOTIFY_PREF[phone]}" != 1 ]]; then
    return 1
  fi
  for key in "${NOTIFY_AGENTS[@]}"; do
    if [[ "${NOTIFY_PREF[$key]}" == 1 ]]; then
      return 0
    fi
  done
  return 1
}

notify_print_row() {
  local key="$1" state extra=""
  state="$(notify_state_word "$key")"
  if [[ "$key" == bell ]]; then
    extra="  ${NOTIFY_VOLUME}%"
  elif [[ "$key" == phone ]]; then
    if [[ -n "${CLUSTERFORK_NTFY_URL:-}" ]]; then
      extra="  $CLUSTERFORK_NTFY_URL"
    else
      extra="  no ntfy url"
    fi
  fi
  printf '       %-13s  %s%s\n' "$key" "$state" "$extra"
}

notify_print_status() {
  local key
  if notify_effective; then
    printf '  notify  ›  on\n'
  else
    printf '  notify  ›  off\n'
  fi
  printf '\n'
  notify_print_row bell
  notify_print_row phone
  printf '\n'
  for key in "${NOTIFY_AGENTS[@]}"; do
    notify_print_row "$key"
  done
}

notify_usage() {
  cat <<'EOF'
Toggle turn-completion notifications.

Usage:
  notify                      show status
  notify all on|off           set every switch
  notify volume <0-100>       set the local bell volume
  notify bell [on|off]        toggle or set the local bell
  notify phone [on|off]       toggle or set phone push
  notify <agent> [on|off]     toggle or set one agent
                              claude, codex, command-code, grok,
                              antigravity
  notify test [bell|phone]    play the bell and/or post a phone test

Prefs: ~/.config/clusterfork/notify-prefs (not overwritten by install)
EOF
}

notify_hint() {
  printf '       Use: notify [all|bell|phone|claude|codex|command-code|grok|antigravity] [on|off]\n' >&2
  printf '            notify volume <0-100>\n' >&2
  printf '            notify test [bell|phone]\n' >&2
}

notify_play_bell() {
  local dir="$1"
  local sound="${CLUSTERFORK_NOTIFY_SOUND:-$dir/bell.mp3}"
  if command -v mpv >/dev/null 2>&1 && [[ -f "$sound" ]]; then
    mpv --no-video --no-terminal --volume="${NOTIFY_VOLUME:-100}" "$sound" \
      </dev/null >/dev/null 2>&1 && return 0
    return 1
  fi
  if [[ -w /dev/tty ]]; then
    printf '\a' >/dev/tty 2>/dev/null && return 0
    return 1
  fi
  return 1
}

notify_post_ntfy() {
  local title="$1" body="$2"
  local url="${CLUSTERFORK_NTFY_URL:-}"
  [[ -n "$url" ]] || return 1
  command -v curl >/dev/null 2>&1 || return 1

  local -a args=(
    --fail
    --silent
    --show-error
    --connect-timeout 1
    --max-time 3
    --request POST
    --header "X-Title: $title"
    --header "X-Priority: high"
    --header "X-Tags: robot"
    --data-binary "$body"
  )
  if [[ -n "${CLUSTERFORK_NTFY_TOKEN:-}" ]]; then
    args+=(--header "Authorization: Bearer $CLUSTERFORK_NTFY_TOKEN")
  fi

  curl "${args[@]}" "$url" </dev/null >/dev/null 2>&1 || return 1
  return 0
}

notify_bell_ready() {
  local dir="$1"
  local sound="${CLUSTERFORK_NOTIFY_SOUND:-$dir/bell.mp3}"
  if command -v mpv >/dev/null 2>&1 && [[ -f "$sound" ]]; then
    return 0
  fi
  [[ -w /dev/tty ]]
}

notify_test_bell() {
  if ! notify_bell_ready "$1"; then
    printf '  ✗  bell  play failed\n' >&2
    return 1
  fi
  # Detach so the clip can finish after this command returns. The job
  # must not inherit stdout or a caller capturing output will wait for it.
  notify_play_bell "$1" </dev/null >/dev/null 2>&1 &
  disown "$!" 2>/dev/null || true
  printf '  ✓  bell  playing\n'
}

notify_test_phone() {
  if [[ -z "${CLUSTERFORK_NTFY_URL:-}" ]]; then
    printf '  ✗  phone  no ntfy url\n' >&2
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    printf '  ✗  phone  curl not found\n' >&2
    return 1
  fi
  if notify_post_ntfy "Clusterfork test" "Phone path works"; then
    printf '  ✓  phone  posted to %s\n' "$CLUSTERFORK_NTFY_URL"
    return 0
  fi
  printf '  ✗  phone  post failed\n' >&2
  return 1
}

notify_run_test() {
  local dir="$1" channel="${2:-}"
  local failed=0
  case "$channel" in
    "")
      notify_test_bell "$dir" || failed=1
      notify_test_phone || failed=1
      ;;
    bell)
      notify_test_bell "$dir" || failed=1
      ;;
    phone)
      notify_test_phone || failed=1
      ;;
    *)
      printf '  ✗  notify test expects bell or phone, not %s\n' "$channel" >&2
      notify_hint
      return 1
      ;;
  esac
  return "$failed"
}

notify_set_all() {
  local value="$1" key
  for key in "${NOTIFY_TARGETS[@]}"; do
    NOTIFY_PREF["$key"]="$value"
  done
}

notify_main() {
  local dir target value
  dir="$(notify_clusterfork_dir)"
  notify_load_env "$dir"
  notify_load_prefs "$dir"

  if [[ $# -eq 0 || "${1:-}" == status ]]; then
    notify_print_status
    return 0
  fi

  case "$1" in
    -h|--help|help)
      notify_usage
      return 0
      ;;
  esac

  if [[ $# -gt 2 ]]; then
    printf '  ✗  unexpected argument: %s\n' "$3" >&2
    notify_hint
    return 1
  fi

  target="$1"
  if [[ "$target" == volume ]]; then
    if [[ $# -ne 2 ]]; then
      printf '  ✗  notify volume requires 0-100\n' >&2
      notify_hint
      return 1
    fi
    if ! value="$(notify_parse_volume "$2")"; then
      printf '  ✗  expected 0-100, not %s\n' "$2" >&2
      return 1
    fi
    NOTIFY_VOLUME="$value"
    notify_save_prefs "$dir"
    printf '  ✓  volume  %s%%\n' "$NOTIFY_VOLUME"
    return 0
  fi

  if [[ "$target" == all ]]; then
    if [[ $# -ne 2 ]]; then
      printf '  ✗  notify all requires on or off\n' >&2
      notify_hint
      return 1
    fi
    if ! value="$(notify_parse_bool "$2")"; then
      printf '  ✗  expected on or off, not %s\n' "$2" >&2
      return 1
    fi
    notify_set_all "$value"
    notify_save_prefs "$dir"
    printf '  ✓  all  %s\n' "$(notify_state_word bell)"
    return 0
  fi

  if [[ "$target" == test ]]; then
    if [[ $# -eq 2 && "$2" != bell && "$2" != phone ]]; then
      printf '  ✗  notify test expects bell or phone, not %s\n' "$2" >&2
      notify_hint
      return 1
    fi
    notify_run_test "$dir" "${2:-}" || return 1
    return 0
  fi

  if ! notify_is_target "$target"; then
    printf '  ✗  unknown target: %s\n' "$target" >&2
    notify_hint
    return 1
  fi

  if [[ $# -eq 1 ]]; then
    if [[ "${NOTIFY_PREF[$target]}" == 1 ]]; then
      value=0
    else
      value=1
    fi
  elif ! value="$(notify_parse_bool "$2")"; then
    printf '  ✗  expected on or off, not %s\n' "$2" >&2
    return 1
  fi

  NOTIFY_PREF["$target"]="$value"
  notify_save_prefs "$dir"
  printf '  ✓  %s  %s\n' "$target" "$(notify_state_word "$target")"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  notify_main "$@"
fi
