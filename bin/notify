#!/usr/bin/env bash
# Toggle and show turn-completion notification prefs.
# Sourced by clusterfork-notify for the same prefs file.

NOTIFY_TARGETS=(bell phone claude codex command-code grok antigravity)
NOTIFY_AGENTS=(claude codex command-code grok antigravity)
NOTIFY_STATUS_HISTORY_LIMIT=5
NOTIFY_LOG_HISTORY_LIMIT=50
NOTIFY_HISTORY_RETAIN=200
declare -A NOTIFY_PREF=()
NOTIFY_VOLUME=100

c_reset=""
c_bold=""
c_dim=""
c_green=""
c_bgreen=""
c_red=""
c_bred=""
c_yellow=""
c_cyan=""
e_reset=""
e_bred=""

notify_color_enabled() {
  local fd="${1:-1}"
  if [[ -n "${NO_COLOR:-}" ]]; then
    return 1
  fi
  if [[ "${CLICOLOR_FORCE:-0}" != "0" || "${FORCE_COLOR:-0}" != "0" ]]; then
    return 0
  fi
  if [[ "${CLICOLOR:-1}" == "0" ]]; then
    return 1
  fi
  if [[ "${TERM:-}" == "dumb" ]]; then
    return 1
  fi
  [[ -t "$fd" ]]
}

notify_init_colors() {
  if notify_color_enabled 1; then
    c_reset=$'\033[0m'
    c_bold=$'\033[1m'
    c_dim=$'\033[90m'
    c_green=$'\033[32m'
    c_bgreen=$'\033[1;32m'
    c_red=$'\033[31m'
    c_bred=$'\033[1;31m'
    c_yellow=$'\033[33m'
    c_cyan=$'\033[36m'
  else
    c_reset=""
    c_bold=""
    c_dim=""
    c_green=""
    c_bgreen=""
    c_red=""
    c_bred=""
    c_yellow=""
    c_cyan=""
  fi

  if notify_color_enabled 2; then
    e_reset=$'\033[0m'
    e_bred=$'\033[1;31m'
  else
    e_reset=""
    e_bred=""
  fi
}

notify_ok() {
  local target="$1" detail="$2" c_det="" c_dreset=""
  case "$detail" in
    on) c_det="$c_green"; c_dreset="$c_reset" ;;
    off) c_det="$c_red"; c_dreset="$c_reset" ;;
  esac
  printf '  %s✓%s  %s%s%s  %s%s%s\n' \
    "$c_bgreen" "$c_reset" \
    "$c_bold" "$target" "$c_reset" \
    "$c_det" "$detail" "$c_dreset"
}

notify_err() {
  printf '  %s✗%s  %s\n' "$e_bred" "$e_reset" "$1" >&2
}

notify_clusterfork_dir() {
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  printf '%s' "${CLUSTERFORK_DIR:-$(cd "$here/.." && pwd)}"
}

notify_load_env() {
  local dir="$1"
  local env_file="${CLUSTERFORK_ENV_FILE:-$dir/.env}"
  local config_file
  for config_file in "$dir/notify/settings.env" "$env_file"; do
    if [[ -f "$config_file" ]]; then
      set -a
      # shellcheck source=/dev/null
      . "$config_file" 2>/dev/null || true
      set +a
    fi
  done
}

notify_parse_bool() {
  case "$1" in
    1|on|true|yes) printf 1 ;;
    0|off|false|no) printf 0 ;;
    *) return 1 ;;
  esac
}

notify_is_target() {
  local target="$1" item
  for item in "${NOTIFY_TARGETS[@]}"; do
    [[ "$item" == "$target" ]] && return 0
  done
  return 1
}

notify_parse_volume() {
  local raw="${1%"%"}"
  [[ "$raw" =~ ^[0-9]+$ ]] || return 1
  raw="$((10#$raw))"
  if (( raw > 100 )); then
    return 1
  fi
  printf '%s' "$raw"
}

notify_defaults() {
  local key
  NOTIFY_PREF=()
  for key in "${NOTIFY_TARGETS[@]}"; do
    NOTIFY_PREF["$key"]=1
  done
  NOTIFY_VOLUME=100
}

notify_load_prefs() {
  local prefs="$1/notify-prefs" line key value parsed
  notify_defaults
  [[ -f "$prefs" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    if [[ "$key" == volume ]]; then
      parsed="$(notify_parse_volume "$value")" || continue
      NOTIFY_VOLUME="$parsed"
      continue
    fi
    notify_is_target "$key" || continue
    parsed="$(notify_parse_bool "$value")" || continue
    NOTIFY_PREF["$key"]="$parsed"
  done < "$prefs"
}

notify_save_prefs() {
  local prefs="$1/notify-prefs" tmp key
  tmp="$prefs.tmp.$$"
  {
    for key in "${NOTIFY_TARGETS[@]}"; do
      printf '%s=%s\n' "$key" "${NOTIFY_PREF[$key]}"
    done
    printf 'volume=%s\n' "$NOTIFY_VOLUME"
  } > "$tmp"
  mv -f "$tmp" "$prefs"
}

notify_state_word() {
  if [[ "${NOTIFY_PREF[$1]}" == 1 ]]; then
    printf on
  else
    printf off
  fi
}

notify_effective() {
  local key
  if [[ "${NOTIFY_PREF[bell]}" != 1 && "${NOTIFY_PREF[phone]}" != 1 ]]; then
    return 1
  fi
  for key in "${NOTIFY_AGENTS[@]}"; do
    if [[ "${NOTIFY_PREF[$key]}" == 1 ]]; then
      return 0
    fi
  done
  return 1
}

notify_history_timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

notify_human_time() {
  local timestamp="$1" formatted
  if formatted="$(date --date="$timestamp" '+%b %-d, %Y %-I:%M %p %Z' 2>/dev/null)"; then
    printf '%s' "$formatted"
  else
    printf '%s' "$timestamp"
  fi
}

notify_append_history_unlocked() {
  local history="$1" timestamp="$2" source="$3" notifications="$4"
  local line_count tmp

  printf '%s\t%s\t%s\n' "$timestamp" "$source" "$notifications" >> "$history" || return 0
  line_count="$(wc -l < "$history")" || return 0
  if (( line_count > NOTIFY_HISTORY_RETAIN )); then
    tmp="${history}.tmp.$$"
    tail -n "$NOTIFY_HISTORY_RETAIN" "$history" > "$tmp" || return 0
    mv -f "$tmp" "$history" || return 0
  fi
}

notify_record_trigger() {
  local dir="$1" source="$2" notifications="$3" timestamp="${4:-}"
  local history="$dir/notify-history"

  [[ -n "$notifications" ]] || return 0
  case "$notifications" in
    bell|phone|bell,phone) ;;
    *) return 0 ;;
  esac

  source="${source//$'\t'/ }"
  source="${source//$'\n'/ }"
  source="${source//$'\r'/ }"
  source="${source:0:32}"
  [[ -n "$source" ]] || source="agent"
  if [[ -z "$timestamp" ]]; then
    timestamp="$(notify_history_timestamp 2>/dev/null)" || return 0
  fi

  # Stop hooks can overlap. Serialize the append/trim when flock is available;
  # history is diagnostic only, so every error remains silent and fail-open.
  if command -v flock >/dev/null 2>&1; then
    (
      flock -x 9 || exit 0
      notify_append_history_unlocked \
        "$history" "$timestamp" "$source" "$notifications"
    ) 2>/dev/null 9>"${history}.lock" || true
  else
    notify_append_history_unlocked \
      "$history" "$timestamp" "$source" "$notifications" 2>/dev/null || true
  fi
}

notify_print_history() {
  local dir="$1" limit="$2" title="$3"
  local history="$dir/notify-history" timestamp display_time source notifications
  local index shown=0
  local -a lines=()

  notify_init_colors
  printf '  %s%s%s  %s›%s  last %s\n' \
    "$c_bold" "$title" "$c_reset" \
    "$c_dim" "$c_reset" \
    "$limit"
  printf '\n'
  printf '       %s%-27s  %-13s  %s%s\n' \
    "$c_bold" "time" "triggered by" "notifications" "$c_reset"

  if [[ -f "$history" ]]; then
    mapfile -t lines < <(tail -n "$limit" "$history" 2>/dev/null)
  fi
  for ((index=${#lines[@]} - 1; index >= 0; index--)); do
    IFS=$'\t' read -r timestamp source notifications <<< "${lines[$index]}"
    [[ -n "$timestamp" && -n "$source" && -n "$notifications" ]] || continue
    display_time="$(notify_human_time "$timestamp")"
    notifications="${notifications//,/, }"
    printf '       %-27s  %s%-13s%s  %s\n' \
      "$display_time" \
      "$c_cyan" "$source" "$c_reset" \
      "$notifications"
    shown=1
  done
  if (( ! shown )); then
    printf '       none yet\n'
  fi
}

notify_print_row() {
  local key="$1" state extra="" c_state=""
  state="$(notify_state_word "$key")"
  if [[ "$state" == on ]]; then
    c_state="$c_green"
  else
    c_state="$c_red"
  fi
  if [[ "$key" == bell ]]; then
    extra="  ${NOTIFY_VOLUME}%"
  elif [[ "$key" == phone ]]; then
    if [[ -n "${CLUSTERFORK_NTFY_URL:-}" ]]; then
      extra="  $CLUSTERFORK_NTFY_URL"
    else
      if [[ -n "$c_yellow" ]]; then
        extra="  ${c_yellow}no ntfy url${c_reset}"
      else
        extra="  no ntfy url"
      fi
    fi
  fi
  printf '       %s%-13s%s  %s%s%s%s\n' \
    "$c_bold" "$key" "$c_reset" \
    "$c_state" "$state" "$c_reset" \
    "$extra"
}

notify_print_status() {
  local dir="$1" key
  notify_init_colors
  if notify_effective; then
    printf '  %snotify%s  %s›%s  %son%s\n' \
      "$c_bold" "$c_reset" "$c_dim" "$c_reset" "$c_bgreen" "$c_reset"
  else
    printf '  %snotify%s  %s›%s  %soff%s\n' \
      "$c_bold" "$c_reset" "$c_dim" "$c_reset" "$c_bred" "$c_reset"
  fi
  printf '\n'
  notify_print_row bell
  notify_print_row phone
  printf '\n'
  for key in "${NOTIFY_AGENTS[@]}"; do
    notify_print_row "$key"
  done
  printf '\n'
  notify_print_history "$dir" "$NOTIFY_STATUS_HISTORY_LIMIT" "recent notifications"
}

notify_usage() {
  cat <<EOF
Toggle turn-completion notifications.

${c_bold}Usage:${c_reset}
  notify                      show status
  notify all on|off           set every switch
  notify volume <0-100>       set the local bell volume
  notify bell [on|off]        toggle or set the local bell
  notify phone [on|off]       toggle or set phone push
  notify <agent> [on|off]     toggle or set one agent
                              claude, codex, command-code, grok,
                              antigravity
  notify test [bell|phone]    play the bell and/or post a phone test
  notify log [count]          show trigger history (default 50, max 200)

${c_bold}Prefs:${c_reset} ~/.config/clusterfork/notify-prefs (not overwritten by install)
${c_bold}History:${c_reset} ~/.config/clusterfork/notify-history (newest 200 retained)
EOF
}

notify_hint() {
  printf '       Use: notify [all|bell|phone|claude|codex|command-code|grok|antigravity] [on|off]\n' >&2
  printf '            notify volume <0-100>\n' >&2
  printf '            notify test [bell|phone]\n' >&2
  printf '            notify log [1-200]\n' >&2
}

notify_play_bell() {
  local dir="$1"
  local sound="${CLUSTERFORK_NOTIFY_SOUND:-$dir/bell.mp3}"
  if command -v mpv >/dev/null 2>&1 && [[ -f "$sound" ]]; then
    mpv --no-video --no-terminal --volume="${NOTIFY_VOLUME:-100}" "$sound" \
      </dev/null >/dev/null 2>&1 && return 0
    return 1
  fi
  if [[ -w /dev/tty ]]; then
    printf '\a' >/dev/tty 2>/dev/null && return 0
    return 1
  fi
  return 1
}

notify_post_ntfy() {
  local title="$1" body="$2"
  local url="${CLUSTERFORK_NTFY_URL:-}"
  [[ -n "$url" ]] || return 1
  command -v curl >/dev/null 2>&1 || return 1

  local -a args=(
    --fail
    --silent
    --show-error
    --connect-timeout 1
    --max-time 3
    --request POST
    --header "X-Title: $title"
    --header "X-Priority: high"
    --header "X-Tags: robot"
    --data-binary "$body"
  )
  if [[ -n "${CLUSTERFORK_NTFY_TOKEN:-}" ]]; then
    args+=(--header "Authorization: Bearer $CLUSTERFORK_NTFY_TOKEN")
  fi

  curl "${args[@]}" "$url" </dev/null >/dev/null 2>&1 || return 1
  return 0
}

notify_bell_ready() {
  local dir="$1"
  local sound="${CLUSTERFORK_NOTIFY_SOUND:-$dir/bell.mp3}"
  if command -v mpv >/dev/null 2>&1 && [[ -f "$sound" ]]; then
    return 0
  fi
  [[ -w /dev/tty ]]
}

notify_test_bell() {
  if ! notify_bell_ready "$1"; then
    notify_err "bell  play failed"
    return 1
  fi
  # Detach so the clip can finish after this command returns. The job
  # must not inherit stdout or a caller capturing output will wait for it.
  notify_play_bell "$1" </dev/null >/dev/null 2>&1 &
  disown "$!" 2>/dev/null || true
  notify_ok "bell" "playing"
}

notify_test_phone() {
  if [[ -z "${CLUSTERFORK_NTFY_URL:-}" ]]; then
    notify_err "phone  no ntfy url"
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    notify_err "phone  curl not found"
    return 1
  fi
  if notify_post_ntfy "Clusterfork test" "Phone path works"; then
    notify_ok "phone" "posted to $CLUSTERFORK_NTFY_URL"
    return 0
  fi
  notify_err "phone  post failed"
  return 1
}

notify_run_test() {
  local dir="$1" channel="${2:-}"
  local failed=0 timestamp notifications=""
  timestamp="$(notify_history_timestamp 2>/dev/null || true)"
  case "$channel" in
    "")
      if notify_test_bell "$dir"; then
        notifications="bell"
      else
        failed=1
      fi
      if notify_test_phone; then
        notifications="${notifications:+$notifications,}phone"
      else
        failed=1
      fi
      ;;
    bell)
      if notify_test_bell "$dir"; then
        notifications="bell"
      else
        failed=1
      fi
      ;;
    phone)
      if notify_test_phone; then
        notifications="phone"
      else
        failed=1
      fi
      ;;
    *)
      notify_err "notify test expects bell or phone, not $channel"
      notify_hint
      return 1
      ;;
  esac
  notify_record_trigger "$dir" "test" "$notifications" "$timestamp"
  return "$failed"
}

notify_set_all() {
  local value="$1" key
  for key in "${NOTIFY_TARGETS[@]}"; do
    NOTIFY_PREF["$key"]="$value"
  done
}

notify_main() {
  local dir target value prev_volume
  dir="$(notify_clusterfork_dir)"
  notify_init_colors
  notify_load_env "$dir"
  notify_load_prefs "$dir"

  if [[ $# -eq 0 || "${1:-}" == status ]]; then
    notify_print_status "$dir"
    return 0
  fi

  case "$1" in
    -h|--help|help)
      notify_usage
      return 0
      ;;
  esac

  if [[ $# -gt 2 ]]; then
    notify_err "unexpected argument: $3"
    notify_hint
    return 1
  fi

  target="$1"
  if [[ "$target" == log ]]; then
    value="${2:-$NOTIFY_LOG_HISTORY_LIMIT}"
    if [[ ! "$value" =~ ^[1-9][0-9]*$ ]] || (( 10#$value > NOTIFY_HISTORY_RETAIN )); then
      notify_err "notify log expects 1-$NOTIFY_HISTORY_RETAIN, not $value"
      return 1
    fi
    value="$((10#$value))"
    notify_print_history "$dir" "$value" "notify log"
    return 0
  fi

  if [[ "$target" == volume ]]; then
    if [[ $# -ne 2 ]]; then
      notify_err "notify volume requires 0-100"
      notify_hint
      return 1
    fi
    if ! value="$(notify_parse_volume "$2")"; then
      notify_err "expected 0-100, not $2"
      return 1
    fi
    prev_volume="$NOTIFY_VOLUME"
    NOTIFY_VOLUME="$value"
    notify_save_prefs "$dir"
    notify_ok "volume" "${prev_volume}% → ${NOTIFY_VOLUME}%"
    return 0
  fi

  if [[ "$target" == all ]]; then
    if [[ $# -ne 2 ]]; then
      notify_err "notify all requires on or off"
      notify_hint
      return 1
    fi
    if ! value="$(notify_parse_bool "$2")"; then
      notify_err "expected on or off, not $2"
      return 1
    fi
    notify_set_all "$value"
    notify_save_prefs "$dir"
    notify_ok "all" "$(notify_state_word bell)"
    return 0
  fi

  if [[ "$target" == test ]]; then
    if [[ $# -eq 2 && "$2" != bell && "$2" != phone ]]; then
      notify_err "notify test expects bell or phone, not $2"
      notify_hint
      return 1
    fi
    notify_run_test "$dir" "${2:-}" || return 1
    return 0
  fi

  if ! notify_is_target "$target"; then
    notify_err "unknown target: $target"
    notify_hint
    return 1
  fi

  if [[ $# -eq 1 ]]; then
    if [[ "${NOTIFY_PREF[$target]}" == 1 ]]; then
      value=0
    else
      value=1
    fi
  elif ! value="$(notify_parse_bool "$2")"; then
    notify_err "expected on or off, not $2"
    return 1
  fi

  NOTIFY_PREF["$target"]="$value"
  notify_save_prefs "$dir"
  notify_ok "$target" "$(notify_state_word "$target")"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  notify_main "$@"
fi
