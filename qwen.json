{
  "$version": 4,
  "model": {
    "name": "qwen3.7-max"
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false,
    "enableAutoSkill": false
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "pioneer/auto",
        "name": "Pioneer Auto",
        "envKey": "PIONEER_API_KEY",
        "baseUrl": "https://api.pioneer.ai/v1",
        "generationConfig": {
          "reasoning": { "effort": "xhigh" }
        }
      },
      {
        "id": "qwen3.7-max",
        "name": "Qwen 3.7 Max",
        "envKey": "PIONEER_API_KEY",
        "baseUrl": "https://api.pioneer.ai/v1",
        "generationConfig": {
          "reasoning": { "effort": "xhigh" }
        }
      },
      {
        "id": "deepseek-ai/DeepSeek-V4-Pro",
        "name": "DeepSeek V4 Pro",
        "envKey": "PIONEER_API_KEY",
        "baseUrl": "https://api.pioneer.ai/v1",
        "generationConfig": {
          "reasoning": { "effort": "xhigh" }
        }
      },
      {
        "id": "moonshotai/Kimi-K2.7-Code",
        "name": "Kimi K2.7 Code",
        "envKey": "PIONEER_API_KEY",
        "baseUrl": "https://api.pioneer.ai/v1",
        "generationConfig": {
          "reasoning": { "effort": "xhigh" }
        }
      },
      {
        "id": "zai-org/GLM-5.2",
