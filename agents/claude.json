{
  "model": "claude-opus-4-8",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "linear@skills-dir": false,
    "chrome-devtools@skills-dir": false,
    "pixellab@skills-dir": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mpv --no-video --no-terminal ~/.config/clusterfork/bell.mp3"
          }
        ]
      }
    ]
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackDrafts": "off"
}
