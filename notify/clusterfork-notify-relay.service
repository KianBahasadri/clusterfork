[Unit]
Description=Clusterfork devbox completion alerts
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.config/clusterfork/bin/clusterfork-notify-relay serve %h/clusterfork/.notify-relay.sock
WorkingDirectory=%h
Environment=PATH=/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=32
CPUQuota=10%
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
