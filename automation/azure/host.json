{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:01",
      "batchSize": 8,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:01:00",
      "messageEncoding": "base64"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "logging": {
    "logLevel": {"default": "Warning", "Function": "Information", "Host.Results": "Information",
                 "Host.Aggregator": "Information", "Worker": "Information"},
    "applicationInsights": {
      "samplingSettings": {"isEnabled": true, "maxTelemetryItemsPerSecond": 5,
                           "excludedTypes": "Request;Exception;Trace"},
      "enableLiveMetrics": false,
      "enablePerformanceCountersCollection": false,
      "httpAutoCollectionOptions": {"enableHttpTriggerExtendedInfoCollection": false,
                                    "enableW3CDistributedTracing": true,
                                    "enableResponseHeaderInjection": false}
    }
  }
}
